# Required for NVIDIA API access
NVIDIA_API_KEY=

# Optional endpoint and model overrides
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
EMB_MODEL=nvidia/nemotron-3-embed-1b
VISION_MODEL=meta/llama-3.2-90b-vision-instruct
VISION_FALLBACKS=meta/llama-3.2-11b-vision-instruct

# Maximum size of one uploaded file, in megabytes
MAX_FILE_SIZE_MB=25

# Local persistence and encrypted document storage
PRISMA_DB_PATH=.prisma/prisma.db
PRISMA_STORAGE_DIR=.prisma/documents
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PRISMA_STORAGE_KEY=
